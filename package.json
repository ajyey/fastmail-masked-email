{
  "name": "fastmail-masked-email",
  "version": "3.0.3",
  "description": "A library for creating, deleting, and updating Fastmail masked emails",
  "author": "Andrew Leonard",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajyey/fastmail-masked-email.git"
  },
  "license": "MIT",
  "keywords": [
    "fastmail",
    "masked",
    "email"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:compile",
    "build:compile": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "vitest",
    "doc": "npm run doc:html",
    "doc:html": "typedoc src/index.ts --out docs && cp logo.png docs/",
    "fix": "npm run lint:fix && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:package && npm run test:docs",
    "test:docs": "typedoc src/index.ts --out /tmp/fastmail-masked-email-docs",
    "test:integration": "npm run build && tsc -p tsconfig.integration.json --noEmit && vitest run --config vitest.integration.config.ts",
    "test:package": "node scripts/test-package.mjs",
    "test:unit": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "axios": "^1.13.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.1",
    "@semantic-release/npm": "^13.1.1",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.6",
    "eslint": "9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "publint": "^0.3.13",
    "rimraf": "^6.1.0",
    "semantic-release": "^25.0.1",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.6"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "MIGRATION.md",
    "logo.png"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
